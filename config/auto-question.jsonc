{
  // opencode-auto-question plugin configuration.
  // Copy to: ~/.config/opencode/auto-question.jsonc
  // {env:VAR} placeholders are interpolated from the environment.

  "enabled": true,

  // Sessions whose selected agent matches one of these names get auto-answered.
  "agents": ["autonomy"],

  // Decision engine: "jev" (TypeSafe decision model), "llm" (JSON-contract
  // chat completion), or "auto" (jev first, llm fallback).
  "engine": "auto",

  // Jev carrier auto-discovery: when apiKey interpolates to empty (e.g. the
  // {env:VAR} below is unset), the plugin uses OpenCode Zen when
  // OPENCODE_API_KEY is set (https://opencode.ai/zen/v1/systemone, model
  // jev-1.13, ~$0.000013/call; jev-1.13-free works only if free endpoints
  // are allowed in the workspace Privacy settings on opencode.ai), else
  // OpenRouter when OPENROUTER_API_KEY is set. Set apiKey (and model/baseUrl)
  // explicitly to force a carrier; the values below are the OpenRouter defaults.
  "jev": {
    "model": "typesafe/jev-1.14",
    "baseUrl": "https://openrouter.ai/api/alpha/decisions",
    "apiKey": "{env:OPENROUTER_API_KEY}",
    "timeoutMs": 15000
  },

  "llm": {
    "baseUrl": "https://api.enmaas.devshift.net/v1",
    "apiKey": "{env:ENMAAS_KEY}",
    "model": "rits/zai-org/glm-5-3",
    "timeoutMs": 60000
  },

  // Pass 1 (no context) answers at or above this confidence immediately.
  "confidenceThreshold": 0.6,

  // After context gathering (pass 2), answers at or above this confidence are
  // sent; below this the human answers via the normal TUI form.
  "fallbackThreshold": 0.35,

  "contextGathering": {
    "agent": "auto-question-ctx",
    "timeoutMs": 30000
  },

  // Pass 0 — project guidance decision agent. When guidance documents exist
  // (see "guidance" below), a tool-using subagent investigates the workspace
  // and answers following that guidance BEFORE the jev/llm engines run. It can
  // produce "Type your own answer" custom replies. Falls back to the normal
  // two-pass flow when the agent fails or the guidance does not cover the
  // question; when guidance covers the question but confidence is low, the
  // question goes to the human (never a generic engine override).
  "agentDecision": {
    "agent": "auto-question-decide",
    "timeoutMs": 60000
  },

  // Guidance documents: plain markdown, concatenated in filename order.
  //   project: <project>/.opencode/auto-question/guidance/*.md
  //   global:  ~/.config/opencode/auto-question/guidance/*.md
  // Global docs load first; project docs are appended after (more specific).
  // Set enabled: false to always use the plain jev/llm engines.
  // Note: with guidance in play, consider raising handlerTimeoutMs (worst
  // case: 60s agent + two engine passes can exceed the 120s default).
  "guidance": {
    "enabled": true,
    "projectPath": ".opencode/auto-question/guidance",
    "globalPath": "~/.config/opencode/auto-question/guidance",
    "maxChars": 20000
  },

  // Hard cap for the entire auto-answer attempt per question request.
  "handlerTimeoutMs": 120000,

  // Fetch the model's reasoning text from the assistant message that called the
  // question tool (tables, recommendations, detailed option descriptions) and
  // include it as context for the decision engine. Dramatically improves
  // accuracy for complex questions where the bare options lack context.
  "immediateContext": true,

  // Inject a summary message into the session history after auto-answering or
  // deferring to human. Visible in the TUI but hidden from the model; carries
  // the session's current agent/model so it never switches agents mid-run.
  "sessionSummary": true,

  // Debug logging to ~/.local/share/opencode-auto-question/log.txt
  "verbose": false
}
