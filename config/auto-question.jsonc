{
  // opencode-auto-question plugin configuration. Optional: without this file
  // the plugin runs on the defaults shown here.
  // Copy to: ~/.config/opencode/auto-question.jsonc
  // {env:VAR} placeholders are interpolated from the environment.
  "$schema": "https://raw.githubusercontent.com/jflowers/opencode-auto-question/main/auto-question.schema.json",

  "enabled": true,

  // Register the bundled agents (autonomy, auto-question-ctx,
  // auto-question-decide). Settings you give an agent of the same name, in
  // opencode.json or agents/*.md, win; the bundled definition fills in the
  // rest. Note: autonomy allows
  // external_directory (every path on disk); see the README to scope it.
  "registerAgents": true,

  // Sessions whose selected agent matches one of these names get auto-answered.
  "agents": ["autonomy"],

  // Agents whose questions are deliberate human gates (e.g. Dewey's curator).
  // Any of these listed in "agents" are dropped from it (with a logged error);
  // "curator" is always included.
  // Independently, any question beginning with "HUMAN_GATE:" is never
  // auto-answered, and project guidance cannot override either rule.
  "humanGatedAgents": ["curator"],

  // Decision engine: "jev" (TypeSafe decision model), "llm" (JSON-contract
  // chat completion), or "auto" (jev first, llm fallback).
  "engine": "auto",

  // Jev carrier auto-discovery: when apiKey interpolates to empty (e.g. the
  // {env:VAR} below is unset), the plugin uses OpenCode Zen when
  // OPENCODE_API_KEY is set (https://opencode.ai/zen/v1/systemone, model
  // jev-1.13, ~$0.000013/call; jev-1.13-free works only if free endpoints
  // are allowed in the workspace Privacy settings on opencode.ai), else
  // OpenRouter when OPENROUTER_API_KEY is set. Set apiKey (and model/baseUrl)
  // explicitly to force a carrier; the values below are the OpenRouter defaults.
  "jev": {
    "model": "typesafe/jev-1.14",
    "baseUrl": "https://openrouter.ai/api/alpha/decisions",
    "apiKey": "{env:OPENROUTER_API_KEY}",
    "timeoutMs": 15000
  },

  // Any OpenAI-compatible chat-completions endpoint.
  "llm": {
    "baseUrl": "https://openrouter.ai/api/v1",
    "apiKey": "{env:OPENROUTER_API_KEY}",
    "model": "openrouter/auto",
    "timeoutMs": 60000,
    // Used instead of "model" when it is the asking session's own model
    // (compared by model name, whatever the provider), so a second opinion
    // doesn't share the asker's blind spots. The first that differs from the
    // asker is used; with none, "model" is kept and a warning is logged.
    "alternateModels": []
  },

  // Pass 1 (no context) answers at or above this confidence immediately.
  "confidenceThreshold": 0.6,

  // Applies only to a decision re-made in pass 2 with gathered context: at or
  // above it the answer is sent, below it the human answers via the TUI form.
  "fallbackThreshold": 0.35,

  // "model" in contextGathering and agentDecision: "provider/model" (opencode
  // ids, e.g. "openrouter/qwen/qwen3-coder") to run the subagent with. Empty
  // uses the agent's own model.
  "contextGathering": {
    "agent": "auto-question-ctx",
    "model": "",
    "timeoutMs": 30000
  },

  // Pass 0 — project guidance decision agent. When guidance documents exist
  // (see "guidance" below), a tool-using subagent investigates the workspace
  // and answers following that guidance BEFORE the jev/llm engines run. It can
  // produce "Type your own answer" custom replies. Falls back to the normal
  // two-pass flow when the agent fails or the guidance does not cover the
  // question; when guidance covers the question but confidence is low, the
  // question goes to the human (never a generic engine override).
  "agentDecision": {
    "agent": "auto-question-decide",
    "model": "",
    "timeoutMs": 60000
  },

  // Guidance documents: plain markdown, concatenated in filename order.
  //   project: <project>/.opencode/auto-question/guidance/*.md
  //   global:  ~/.config/opencode/auto-question/guidance/*.md
  // Global docs load first; project docs are appended after (more specific).
  // Set enabled: false to always use the plain jev/llm engines.
  // Note: with guidance in play, consider raising handlerTimeoutMs (worst
  // case: 60s agent + two engine passes can exceed the 120s default).
  "guidance": {
    "enabled": true,
    "projectPath": ".opencode/auto-question/guidance",
    "globalPath": "~/.config/opencode/auto-question/guidance",
    "maxChars": 20000
  },

  // Hard cap for the entire auto-answer attempt per question request.
  "handlerTimeoutMs": 120000,

  // A question the plugin does not answer (low confidence, engine failure,
  // timeout): "human" leaves it pending for the TUI form. "reject" answers it
  // with "NO_SECOND_OPINION: deferred (...)" so an unattended session (a TUI
  // nobody watches, `opencode serve`) continues instead of hanging, and rejects HUMAN_GATE: questions (which
  // ends the run) instead of leaving them pending; a gate is never answered.
  "onDefer": "human",

  // Every question's outcome is written as one JSON line to
  // ~/.local/share/opencode-auto-question/results.jsonl. With resultTrailer,
  // the answer the asking agent receives also ends with
  // AUTO_QUESTION_RESULT {"outcome":...,"answer":...,"confidence":...,
  // "pass":...,"engine":...,"model":...,"rationale":...}.
  "resultTrailer": false,

  // Fetch the model's reasoning text from the assistant message that called the
  // question tool (tables, recommendations, detailed option descriptions) and
  // include it as context for the decision engine. Dramatically improves
  // accuracy for complex questions where the bare options lack context.
  "immediateContext": true,

  // Inject a summary message into the session history after auto-answering or
  // deferring to human. Visible in the TUI but hidden from the model; carries
  // the session's current agent/model so it never switches agents mid-run.
  "sessionSummary": true,

  // Debug logging to ~/.local/share/opencode-auto-question/log.txt
  "verbose": false,

  // second_opinion tool: an agent passes a question, options and only the case
  // facts, and gets {outcome, answer, confidence, pass, engine, model,
  // rationale, reason} back as JSON. It never asks a human. When enabled it is
  // denied globally (unless your opencode config sets a global rule for it)
  // and allowed for every agent with a profile below, unless that agent sets
  // its own second_opinion rule. Other agents opt in with
  // permission: { second_opinion: allow }.
  "secondOpinion": { "enabled": false },

  // Headless mode: no question form is ever shown. The plugin's own
  // `question` tool answers in the tool call for every agent (not just
  // "agents"), and questions get `question: allow` in every agent without
  // its own rule, subagents included. A question it can't answer confidently
  // gets a NO_SECOND_OPINION: marker; a human gate gets HUMAN_GATE_UNANSWERED.
  // AUTO_QUESTION_HEADLESS=1 (or 0) in the environment overrides this.
  "headless": false,

  // Headless mode: what the agent is told when a human must decide. A
  // playbook (inline text, or a file relative to this one) replaces the
  // default instruction to stop and name the decision, e.g. "comment on the
  // PR with the decision needed, push your work as a draft, end your turn".
  // deferred: "decide" lets the agent decide unconfident questions itself;
  // "escalate" treats them like human gates. Human gates always escalate.
  // AUTO_QUESTION_ESCALATION=<path> sets the file for one process. A profile
  // can set its own.
  "escalation": { "text": "", "file": "", "deferred": "decide" },

  // Per-agent overrides, keyed by agent name (case-insensitive). Each is
  // deep-merged over the settings above for that agent's questions only.
  // Allowed keys: engine, jev, llm, confidenceThreshold, fallbackThreshold,
  // contextGathering, agentDecision, guidance (plus guidance.inheritGlobal),
  // immediateContext, sessionSummary, handlerTimeoutMs, onDefer,
  // resultTrailer. Human gates always apply. Example:
  //   "hud-supervisor": {
  //     "guidance": { "globalPath": "auto-question/hud-guidance", "projectPath": "", "inheritGlobal": false },
  //     "confidenceThreshold": 0.7,
  //     "llm": { "model": "qwen/qwen3-235b-a22b", "alternateModels": ["deepseek/deepseek-v4"] },
  //     "contextGathering": { "model": "openrouter/qwen/qwen3-coder" }
  //   }
  "profiles": {}
}
